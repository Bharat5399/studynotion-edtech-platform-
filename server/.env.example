# Backend env file (server folder)
# Fill each value in after creating the matching account.
# NEVER commit this file or share these values in chat/screenshots.

# ---- Auth ----
# Any long random string works, e.g. generate one at https://randomkeygen.com
JWT_SECRET=

# ---- MongoDB Atlas ----
# Get this from Atlas -> Database -> Connect -> Drivers
# Looks like: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/studynotion
MONGODB_URL=

# ---- Gmail (for OTP / emails) ----
MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASS=

# ---- Cloudinary (for image/video uploads) ----
# Get these from your Cloudinary Dashboard homepage
CLOUD_NAME=
API_KEY=
API_SECRET=

# ---- Razorpay (for payments, test mode) ----
# Get these from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY=
RAZORPAY_SECRET=

# ---- Server ----
PORT=4000
